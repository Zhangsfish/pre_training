---
import { getCollection } from 'astro:content';
import { publicView } from '../scripts/content.mjs';
import profile from '../../publication/profile.json';
import home from '../../publication/home.json';
import registry from '../LINKS.json';
import Intro from './components/Intro.astro';
import ProjectIndex from './components/ProjectIndex.astro';
import Project from './components/Project.astro';
import Teaching from './components/Teaching.astro';
import './directions.css';
interface Props { variant:'a'|'b'|'c' }
const {variant}=Astro.props;
const entries=await getCollection('projects');
const view=publicView({profile,home,links:registry.links,projects:entries.map(e=>e.data)});
const projects=view.projects.filter(p=>['kin','spps'].includes(p.id));
const teaching=view.projects.find(p=>p.id==='teaching')!;
const labels={a:'编辑式作品档案',b:'产品案例展厅',c:'简洁研究札记'};
const email=view.links.find(l=>l.id==='email')!;
---
<!doctype html>
<html lang="zh-CN">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{variant.toUpperCase()} · {labels[variant]} · {view.profile.name}</title></head>
<body class={`direction-${variant}`} data-direction={variant}>
  <a class="skip" href="#main">跳到正文</a>
  <div class="review-bar"><span>视觉提案 {variant.toUpperCase()} / {labels[variant]}</span><nav aria-label="视觉方向">{(['a','b','c'] as const).map(id=><a href={`/review/${id}/`} aria-current={id===variant?'page':undefined}>{id.toUpperCase()}</a>)}</nav></div>
  <div class="page-frame">
    <header class="identity"><a href="#main" class="name"><span data-copy="name">{view.profile.name}</span><span class="romanized" data-copy="romanized">{view.profile.romanized_name}</span></a><a class="mail" href={email.url}>邮件联系 ↗</a>{variant==='c' && <ProjectIndex />}</header>
    <main id="main">
      <section class="hero" aria-label="个人介绍"><Intro view={view} />{variant!=='c' && <ProjectIndex />}</section>
      <section class="work" id="work" aria-labelledby="work-heading"><div class="section-heading"><h2 id="work-heading">项目选读</h2><span>KIN / SPPS</span></div><div class="project-list">{projects.map((p,i)=><Project project={p} index={i} variant={variant} />)}</div></section>
      <Teaching project={teaching} />
      <footer><span data-copy="email">{view.profile.email}</span><a href="#main">返回顶部 ↑</a></footer>
    </main>
  </div>
</body>
</html>
