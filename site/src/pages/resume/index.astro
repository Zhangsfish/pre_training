---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {siteContent} from '../../lib/site';
import {display} from '../../../../resume/scripts/model.mjs';
import manifest from '../../../../publication/resume-manifest.json';
import variant from '../../../../resume/variants/general-zh.json';
import profile from '../../../../publication/profile.json';
import claims from '../../../../publication/claims.json';
import registry from '../../../LINKS.json';
import {getCollection} from 'astro:content';
const view=await siteContent();
const resume=display(variant,{profile,claims:claims.claims,projects:(await getCollection('projects')).map(p=>p.data),links:registry.links});
---
<BaseLayout title="通用简历" description="张朔的教育与项目实践，可下载一页中文通用简历。" view={view}>
<div class="resume"><p class="eyebrow">{view.hero.eyebrow}</p><h1>{resume.name} / 通用简历</h1><p>{resume.birth} · {resume.phone} · <a href={`mailto:${resume.email}`}>{resume.email}</a></p><p class="note">更新于 {manifest.date} · A4 一页 · 中文文字可选择</p><p><a class="primary" href={manifest.href} download="zhang-shuo-resume.pdf">下载通用简历 PDF ↗</a></p>
<section class="resume-section"><h2>教育背景</h2>{resume.education.map((e: {school:string;program:string;period:string;detail:string})=><article><h3>{e.school}</h3><p>{e.program} · {e.period}</p>{e.detail&&<p>{e.detail}</p>}</article>)}</section>
<section class="resume-section"><h2>项目与实践</h2>{resume.projects.map((p: {id:string;local_href:string;title:string;period:string|null;status:string;bullets:string[];links:{id:string;url:string;label:string}[]})=><article class="resume-project" data-project={p.id}><h3><a href={p.local_href}>{p.title}</a>{p.period&&` · ${p.period}`}</h3><p class="status">{p.status}</p><ul>{p.bullets.map((b:string)=><li>{b}</li>)}</ul><div class="links">{p.links.map(l=><a href={l.url}>{l.label} ↗</a>)}</div></article>)}</section></div>
</BaseLayout>
