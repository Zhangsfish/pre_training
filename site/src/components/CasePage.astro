---
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaExperience from './MediaExperience.astro';
import GalleryRuntime from './GalleryRuntime.astro';
import NuclideText from './NuclideText.astro';
import {siteContent} from '../lib/site';
import {englishUi,overlayGallery} from '../../scripts/english.mjs';
import gallery from '../../../publication/gallery.json';
import teachingWorksZh from '../../../publication/teaching-works.json';
import teachingWorksEn from '../../../publication/en/teaching-works.json';
import assetRegistry from '../../assets-manifest.json';
interface Props {slug:string;locale:'zh'|'en'}
const {slug,locale}=Astro.props;
const english=locale==='en';
const view=await siteContent(locale);
const project=view.cases.find(p=>p.id===slug);
if(!project)throw new Error(`Unknown case ${slug}`);
const galleryCopy=(english?overlayGallery(gallery):gallery) as typeof gallery;
const ui=english?englishUi():null;
const root=english?'/en/':'/';
const p=galleryCopy.projects.find(p=>p.id===project.id);
const i=p?galleryCopy.projects.indexOf(p):0;
const next=p?galleryCopy.projects[(i+1)%galleryCopy.projects.length]:null;
const lead=project.sections.slice(0,p?3:project.sections.length);
const deeper=p?project.sections.slice(3):[];
const teachingWorks=english?teachingWorksEn:teachingWorksZh;
const teachingAssetPath=(id:string)=>assetRegistry.assets.find(asset=>asset.id===id)?.path;
---
<BaseLayout title={p?.name??project.title} description={project.summary} view={view} locale={locale}>
<div class="breadcrumb"><a href={`${root}#work`}>{english?ui!.case.all_work:'← 全部作品'}</a></div>
<article class:list={['visual-case',{'text-case':!p}]}>
<header class="visual-case-head"><p class="overline">{p?.label??(project.id==='quickmap'?(english?'APP / MAP Q&A':'APP / 地图图文问答'):'RESEARCH & PRACTICE')}</p><h1>{p?.name??project.title}</h1>{p?.id==='spps'&&<p class="full-project-name">{p.full_name}</p>}<p class="work-caption">{project.summary}</p><p class="case-meta">{project.period} · {project.status}</p><div class="case-actions">{p&&<button class="pill primary-pill" data-film={`/media/${p.film}`} data-title={p.name}>▶ {p.id==='spps'?(english?ui!.case.watch_machine:'观看设备运行'):(english?ui!.case.watch_film:'观看完整影片')} · {p.duration}</button>}{project.links.map(l=><a class="pill" href={l.url} target="_blank" rel="noopener noreferrer">{l.label} ↗</a>)}</div></header>
{p&&<MediaExperience project={p} locale={locale} />}
{project.id==='quickmap'&&<figure class="quickmap-case-image"><a href="/media/quickmap-dalian-arctic.png" target="_blank" rel="noopener noreferrer" aria-label={english?'Open the full-size QuickMap prototype screenshot':'查看 QuickMap 原型大图'}><img src="/media/quickmap-dalian-arctic.png" alt={english?'Chinese-language QuickMap prototype showing schematic routes from Dalian to Europe and a sourced explanation':'QuickMap 原型：大连至欧洲的示意航线与带来源的文字解释'} width="1280" height="800" /></a><figcaption>{english?'Open the original Chinese screenshot to zoom · Routes and points are schematic, not navigation data.':'点击查看大图 · 航线和点位为示意，不是航行数据。'}</figcaption></figure>}
<div class="case-story">
{lead.map(s=><section><h2>{s.heading}</h2>{s.blocks.map(b=>b.kind==='list'?<ul>{b.items.map(item=><li><NuclideText text={item} /></li>)}</ul>:<p><NuclideText text={b.text} /></p>)}</section>)}
{deeper.length>0&&<details class="case-deeper" open={p?.id==='kin'}><summary>{p?.id==='kin'?(english?ui!.case.more_kin:'市场判断与长期方向'):(english?ui!.case.more_other:'展开更多过程与取舍')}</summary>{deeper.map(s=><section><h2>{s.heading}</h2>{s.blocks.map(b=>b.kind==='list'?<ul>{b.items.map(item=><li><NuclideText text={item} /></li>)}</ul>:<p><NuclideText text={b.text} /></p>)}</section>)}</details>}
<aside class="ownership-note"><p class="overline">{english?ui!.case.my_work:'我的工作'}</p><p>{project.ownership}</p><p>{project.result}</p></aside>
<p class="case-footnote">{project.boundary}</p>
</div>
{project.id==='teaching'&&<section class="teaching-portfolio" aria-labelledby="teaching-portfolio-title">
  <p class="overline">TEACHING MATERIALS</p>
  <h2 id="teaching-portfolio-title">{english?'Teaching materials':'教学作品'}</h2>
  <p class="teaching-portfolio-intro">{teachingWorks.intro}</p>
  <div class="teaching-work-grid">
    {teachingWorks.works.map(work=><section class="teaching-work" aria-labelledby={`teaching-${work.id}`}>
      <p class="teaching-work-kind">{work.kind} · {work.subtitle}</p>
      <h3 id={`teaching-${work.id}`}>{work.title}</h3>
      <p class="teaching-work-contribution">{work.contribution}</p>
      <p class="teaching-work-summary">{work.summary}</p>
      {work.preview_asset_ids.length>0&&<p class="teaching-preview-count">{english?`${work.preview_asset_ids.length} question pages · scroll and click to enlarge`:`共 ${work.preview_asset_ids.length} 页试题 · 横向浏览，点击放大`}</p>}
      {work.preview_asset_ids.length>0&&<div class="teaching-preview-scroll" tabindex="0" role="group" aria-label={english?`${work.title}: figures with question text concealed`:`${work.title}：图示预览，题干已遮隐`}>
        {work.preview_asset_ids.map((id,index)=><figure class="teaching-preview-page">
          <button class="teaching-preview-zoom" data-zoom={`/${teachingAssetPath(id)}`} data-title={english?`${work.title} · Page ${index+1} · Question text concealed`:`${work.title} · 第 ${index+1} 页 · 题干已遮隐`} aria-label={english?`Enlarge page ${index+1} of ${work.title}`:`放大${work.title}第 ${index+1} 页`}>
            <img src={`/${teachingAssetPath(id)}`} alt={english?`Question page ${index+1}: figures visible, question text concealed`:`试题第 ${index+1} 页：图示清晰，题干已遮隐`} loading="eager" width="840" height="1188" />
          </button>
          <figcaption>{english?`Page ${index+1}`:`第 ${index+1} 页`}</figcaption>
        </figure>)}
      </div>}
      {work.download_asset_id&&teachingAssetPath(work.download_asset_id)
        ?<a class="pill teaching-download" href={`/${teachingAssetPath(work.download_asset_id)}`} download>{english?'Download reviewed PDF':'下载审校 PDF'} ↓</a>
        :<p class="teaching-work-status">{work.status}</p>}
      {work.preview_asset_ids.length>0&&<p class="teaching-page-note">{english?'Click a page to view its diagrams, spectra and experimental photos. Question text is concealed; the original exam and answer sheet are not downloadable.':'点击页面可查看结构图、谱图和实验照片；题干文字已遮隐，原卷与答题纸不提供下载。'}</p>}
    </section>)}
  </div>
</section>}
{p&&<><div class:list={['still-gallery',{'hardware-stills':p.id==='spps'}]}>{p.scenes.slice(1).map(s=><figure><button data-zoom={`/media/${s.image}`} data-title={s.label} aria-label={`${english?ui!.case.zoom:'放大：'}${s.label}`}><img src={`/media/${s.image}`} alt={`${p.name}${english?': ':'：'}${s.label}`} loading="lazy" width="1440" height="900" /></button><figcaption>{s.label}</figcaption></figure>)}</div>
{p.id==='spps'&&<div class="hardware-video-row"><div><p class="overline">IN MOTION</p><h2>{english?ui!.case.motion_title:'流路、泵、控制。'}</h2><p>{english?ui!.case.motion_caption:'设备运行实拍'}</p></div><video controls playsinline preload="none" poster="/media/spps-operation.webp" src="/media/spps-operation.mp4" aria-label={english?'Machine operation video':'设备运行视频'}></video><div><button class="pill" data-film="/media/spps-monitor.mp4" data-title={english?'Machine and monitoring interface':'设备与监测界面'}>{english?ui!.case.motion_other:'▶ 另一段运行实拍'}</button></div></div>}</>}
</article>
<div class="case-next"><a href={`${root}#work`}>{english?ui!.case.all_work:'← 全部作品'}</a>{next&&<a href={`${root}work/${next.id}/`}>{english?ui!.case.next:'继续看：'}{next.name} →</a>}</div><GalleryRuntime locale={locale} />
</BaseLayout>
