{
  "name": "pre-training-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23 || >=24 <25"
  },
  "scripts": {
    "check": "node scripts/validate-content.mjs && astro check",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs production",
    "review:build": "node scripts/build.mjs review",
    "preview": "astro preview --host 127.0.0.1",
    "review:preview": "node scripts/preview.mjs"
  },
  "dependencies": {
    "astro": "7.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "24.13.6",
    "typescript": "6.0.3"
  }
}
