---
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaExperience from '../components/MediaExperience.astro';
import GalleryRuntime from '../components/GalleryRuntime.astro';
import {siteContent} from '../lib/site';
import gallery from '../../../publication/gallery.json';
import registry from '../../LINKS.json';
const view=await siteContent();
const link=(id:string)=>registry.links.find(l=>l.id===id)!.url;
---
<BaseLayout title="作品" description={gallery.intro} view={view}>
<section class="gallery-intro"><div><p class="overline">ZHANG SHUO / SELECTED WORK</p><h1>{gallery.title}</h1></div><p>{gallery.intro}</p></section>
<div id="work" class="work-gallery">{gallery.projects.map((p,i)=><section class={`work-section work-${p.id}`} aria-labelledby={`title-${p.id}`}><div class="work-heading"><div><p class="overline">0{i+1} / {p.label}</p><h2 id={`title-${p.id}`}><a href={`/work/${p.id}/`}>{p.name}</a></h2><p class="work-caption">{p.caption}</p></div><div class="work-actions">{p.id==='qq-lingxi'&&<a class="pill primary-pill" href={link('qq-lingxi-demo')} target="_blank" rel="noopener noreferrer">体验产品 ↗</a>}<a class="text-link" href={`/work/${p.id}/`}>{p.id==='spps'?'看看这台机器':'打开作品'} ↗</a></div></div><MediaExperience project={p} /></section>)}</div>
<section id="contact" class="contact-strip"><div><p class="overline">SAY HELLO</p><a class="contact-email" href={link('email')}>{view.profile.email} ↗</a></div><div class="contact-secondary"><a href="/resume/">简历</a><a href={link('github-profile')}>GitHub ↗</a></div></section>
<GalleryRuntime />
</BaseLayout>
