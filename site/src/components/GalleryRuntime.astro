---
import {englishUi} from '../../scripts/english.mjs';
interface Props {locale?:'zh'|'en'}
const {locale='zh'}=Astro.props;
const media=locale==='en'?englishUi().media:null;
---
<dialog id="media-dialog" aria-labelledby="media-title"><div class="dialog-top"><h2 id="media-title"></h2><button class="close-dialog" aria-label={locale==='en'?media!.close:'关闭预览'}>{locale==='en'?media!.close:'关闭 ×'}</button></div><div class="dialog-content"></div></dialog>
<script src="../scripts/gallery.ts"></script>
