---
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaExperience from './MediaExperience.astro';
import GalleryRuntime from './GalleryRuntime.astro';
import AppCarousel from './AppCarousel.astro';
import AppFilm from './AppFilm.astro';
import {siteContent} from '../lib/site';
import {englishUi,overlayApps,overlayGallery} from '../../scripts/english.mjs';
import gallery from '../../../publication/gallery.json';
import appsShowcase from '../../../publication/apps-showcase.json';
import registry from '../../LINKS.json';
interface Props {locale:'zh'|'en'}
const {locale}=Astro.props;
const english=locale==='en';
const view=await siteContent(locale);
const galleryCopy=(english?overlayGallery(gallery):gallery) as typeof gallery;
const appsCopy=(english?overlayApps(appsShowcase):appsShowcase) as typeof appsShowcase;
const ui=english?englishUi():null;
const root=english?'/en/':'/';
const link=(id:string)=>registry.links.find(l=>l.id===id)!.url;
const quickmap=view.cases.find(p=>p.id==='quickmap')!;
---
<BaseLayout title={english?ui!.home.title:'作品与我'} description={view.hero.intro} view={view} locale={locale}>
<section class="gallery-intro person-intro"><div><p class="overline">{view.hero.eyebrow}</p><h1>{view.hero.title}</h1></div><p>{view.hero.intro}</p></section>
<div id="work" class="work-gallery">
  <p class="overline selected-heading">{english?ui!.home.selected:'SELECTED WORK / 做出来，给你看。'}</p>
  <div class="apps-grid">{appsCopy.apps.map((app,i)=><section class={`work-section app-showcase app-${app.id}`} aria-labelledby={`title-${app.id}`}>
    <div class="work-heading"><div><p class="overline">APP 0{i+1} / {app.label}</p><h2 id={`title-${app.id}`}>{app.name}</h2><p class="work-caption">{app.tagline}</p></div></div>
    <div class="app-showcase-media"><AppFilm name={app.name} poster={app.slides[0].file} films={app.films} note={app.film_note} locale={locale} /><div><AppCarousel name={app.name} slides={app.slides} locale={locale} /></div></div>
    <div class="app-narrative app-showcase-narrative"><p class="app-status">{app.status}</p><h3>{english?ui!.home.scenario:'需求场景'}</h3><p>{app.scenario}</p><h3>{english?ui!.home.response:'它怎么回应'}</h3><p>{app.product}</p></div>
  </section>)}
  <section class="work-section app-showcase app-quickmap" aria-labelledby="title-quickmap">
    <div class="work-heading"><div><p class="overline">APP 03 / {english?'GEOGRAPHIC Q&A':'地图图文问答'}</p><h2 id="title-quickmap"><a href={`${root}work/quickmap/`}>QuickMap</a></h2><p class="work-caption">{quickmap.summary}</p></div><div class="work-actions"><a class="text-link" href={`${root}work/quickmap/`}>{english?'Explore the Dalian case':'查看大连案例'} ↗</a></div></div>
    <a class="quickmap-home-image" href={`${root}work/quickmap/`} aria-label={english?'Open the QuickMap Dalian case':'查看 QuickMap 大连案例'}><img src="/media/quickmap-dalian-arctic.png" alt={english?'QuickMap prototype with schematic Arctic and southern routes beside a sourced answer':'QuickMap 原型：北极与南线示意和带来源的文字回答并排展示'} width="1280" height="800" loading="lazy" /></a>
    <div class="app-narrative quickmap-home-note"><p class="app-status">{quickmap.status}</p><p>{english?'A static showcase of a Codex conversation sending a structured answer to the Windows map prototype.':'静态展示 Codex 对话将结构化回答送进 Windows 地图原型的过程。'}</p><p>{quickmap.boundary}</p></div>
  </section></div>
  {galleryCopy.projects.map((p,i)=><section class={`work-section work-${p.id}`} aria-labelledby={`title-${p.id}`}><div class="work-heading"><div><p class="overline">0{i+1} / {p.label}</p><h2 id={`title-${p.id}`}><a href={`${root}work/${p.id}/`}>{p.name}</a></h2><p class="work-caption">{p.caption}</p></div><div class="work-actions"><a class="text-link" href={`${root}work/${p.id}/`}>{p.id==='spps'?(english?ui!.home.spps_action:'看看这台机器'):(english?ui!.home.work_action:'了解这个作品')} ↗</a></div></div><MediaExperience project={p} locale={locale} /></section>)}
</div>
<section id="about" class="about-section" aria-labelledby="about-title"><p class="overline">BEHIND THE WORK</p><h2 id="about-title">{english?ui!.home.about_title:'这些作品背后，我在意什么。'}</h2><div class="care-grid">{view.personal.map(p=><div><h3>{p.title}</h3><p>{p.text}</p></div>)}</div></section>
<section class="more-practice" aria-labelledby="more-title"><div class="section-heading"><p class="overline">MORE PRACTICE</p><h2 id="more-title">{english?ui!.home.more_title:'也在这些地方，学会把事情做好。'}</h2></div>{view.moreProjects.map(p=><a id={p.id} class="practice-row" href={`${root}work/${p.id}/`}><div><h3>{p.title} <span aria-hidden="true">↗</span></h3><p>{p.summary}</p></div><span class="practice-period">{p.period}</span></a>)}</section>
<section id="contact" class="contact-strip"><div><p class="overline">SAY HELLO</p><a class="contact-email" href={link('email')}>{view.profile.email} ↗</a></div><div class="contact-secondary"><a href={`${root}resume/`}>{english?ui!.home.resume:'简历'}</a><a href={link('github-profile')}>GitHub ↗</a></div></section>
<GalleryRuntime locale={locale} />
</BaseLayout>
