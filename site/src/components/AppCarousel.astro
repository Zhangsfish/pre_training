---
interface Slide {file:string;label:string}
import {englishUi} from '../../scripts/english.mjs';
interface Props {name:string;slides:Slide[];locale?:'zh'|'en'}
const {name,slides,locale='zh'}=Astro.props;
const media=locale==='en'?englishUi().media:null;
---
<div class="app-carousel" data-carousel aria-label={`${name}${locale==='en'?' ':''}${media?.screenshots??'宣传截图'}`}>
  <div class="app-carousel-image">
    {slides.map((slide,i)=><img data-slide data-label={slide.label} src={`/media/${slide.file}`} alt={`${name}${locale==='en'?': ':'：'}${slide.label}`} width="1320" height="2868" loading={i===0?'eager':'lazy'} hidden={i!==0} />)}
    <button class="app-slide-zoom" data-zoom={`/media/${slides[0].file}`} data-title={`${name}${locale==='en'?': ':'：'}${slides[0].label}`} aria-label={locale==='en'?`Enlarge ${name} ${media!.screenshots}`:`放大${name}宣传截图`}>{media?.zoom??'放大 ↗'}</button>
  </div>
  <div class="app-carousel-controls"><button data-prev aria-label={locale==='en'?`${name} ${media!.previous}`:`${name}上一张宣传截图`}>←</button><span data-count aria-live="polite">01 / {String(slides.length).padStart(2,'0')}</span><button data-next aria-label={locale==='en'?`${name} ${media!.next}`:`${name}下一张宣传截图`}>→</button></div>
  <p class="app-carousel-caption" data-caption>{slides[0].label}</p>
</div>
